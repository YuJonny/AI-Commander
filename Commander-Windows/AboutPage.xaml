<UserControl
    x:Class="Commander.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <StackPanel>
        <StackPanel Margin="0,18,0,28" HorizontalAlignment="Center">
            <Image
                Width="72"
                Height="72"
                HorizontalAlignment="Center"
                RenderOptions.BitmapScalingMode="HighQuality"
                Source="pack://application:,,,/Resources/app_logo.png" />
            <TextBlock
                x:Name="LblAppName"
                Margin="0,12,0,0"
                HorizontalAlignment="Center"
                FontSize="24"
                FontWeight="SemiBold"
                Text="AI接线员" />
            <TextBlock
                x:Name="LblVersion"
                Margin="0,4,0,0"
                HorizontalAlignment="Center"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="AI Commander · 2.0" />
            <TextBlock
                x:Name="LblHeroDescription"
                Margin="0,8,0,0"
                HorizontalAlignment="Center"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="将耳机媒体键映射为键盘按键" />
            <TextBlock
                x:Name="LblFree"
                Margin="0,3,0,0"
                HorizontalAlignment="Center"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="为爱发电 永久免费" />
        </StackPanel>

        <TextBlock x:Name="LblProductTitle" Style="{StaticResource SectionTitle}" Text="关于" />
        <Border Margin="0,0,0,24" Style="{StaticResource SubtlePanel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ui:SymbolIcon
                    Grid.Column="0"
                    VerticalAlignment="Top"
                    Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                    Symbol="ShieldLock20" />
                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="LblPrivacyTitle" FontSize="14" FontWeight="SemiBold" Text="全程本地" />
                    <TextBlock
                        x:Name="LblDesc"
                        Margin="0,5,0,0"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="录音、识别与可选润色均在本机完成。"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock x:Name="LblRecommendedTitle" Style="{StaticResource SectionTitle}" Text="推荐搭配 App" />
        <Border Margin="0,0,0,24" Style="{StaticResource SubtlePanel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ui:SymbolIcon
                    Grid.Column="0"
                    VerticalAlignment="Top"
                    Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                    Symbol="Mic20" />
                <StackPanel Grid.Column="1">
                    <ui:HyperlinkButton
                        x:Name="BtnTypeless"
                        Margin="-8,-7,0,0"
                        HorizontalAlignment="Left"
                        Content="Typeless"
                        NavigateUri="https://www.typeless.com/?via=jonny" />
                    <TextBlock
                        x:Name="LblTypelessDetail"
                        Margin="0,1,0,0"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="语音输入" />
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock x:Name="LblHardwareTitle" Style="{StaticResource SectionTitle}" Text="推荐搭配硬件" />
        <Border Margin="0,0,0,24" Style="{StaticResource SubtlePanel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ui:SymbolIcon
                    Grid.Column="0"
                    VerticalAlignment="Top"
                    Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                    Symbol="PhoneDesktop20" />
                <StackPanel Grid.Column="1">
                    <ui:HyperlinkButton
                        x:Name="BtnNativeUnion"
                        Margin="-8,-7,0,0"
                        HorizontalAlignment="Left"
                        Content="Native Union 复古电话"
                        NavigateUri="https://s.click.taobao.com/t?e=m%3D2%26s%3DwIrhGUcHebRw4vFB6t2Z2ueEDrYVVa6424t41fwIvtDRnNAdhLhtk430ZFekjizvxL1QHRKL8qiA5rFvxyOF9bwBMngvQdOvBQ7ZDE%2F6%2BIeRXNdY%2BjBkB5eYDQwFj6yC8kftjCRdkjx9Tuff7Tu%2FYJiUD8YEbaigH9ofgWr0NEuwIB%2BqTHya4ovEYPUpsQ%2FF2%2BRbLWXc2uZ5pCmcDdfSii21iRm1aQiYoGwWYjQ2nPkzWlhic%2BUoh0NEJ7GOeqvGxg5p7bh%2BFbQ%3D" />
                    <TextBlock
                        x:Name="LblNativeUnionDetail"
                        Margin="0,1,0,0"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="更具时代反差感 | Apple Store入驻配件"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock x:Name="LblDiagnosticsTitle" Style="{StaticResource SectionTitle}" Text="诊断" />
        <Border Margin="0,0,0,24" Style="{StaticResource SubtlePanel}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="LblDiagnosticsToggle" FontSize="14" FontWeight="SemiBold" Text="语音链路诊断" />
                        <TextBlock
                            x:Name="LblDiagnosticsDescription"
                            Margin="0,4,16,0"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="仅排查问题时开启；会在本地保存录音与各阶段结果。"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <ui:ToggleSwitch
                        x:Name="SwDiagnostics"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Checked="SwDiagnostics_Changed"
                        Unchecked="SwDiagnostics_Changed" />
                </Grid>
                <Separator Margin="0,16" />
                <Button
                    x:Name="BtnOpenDiagnostics"
                    HorizontalAlignment="Left"
                    Style="{StaticResource CompactButton}"
                    Click="BtnOpenDiagnostics_Click">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Margin="0,0,8,0" Symbol="FolderOpen20" />
                        <TextBlock x:Name="LblOpenDiagnostics" Text="打开诊断文件夹" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <TextBlock x:Name="LblDeveloperTitle" Style="{StaticResource SectionTitle}" Text="开发者" />
        <Border Style="{StaticResource SubtlePanel}">
            <StackPanel>
                <TextBlock FontSize="14" FontWeight="SemiBold" Text="Jonny Yu" />
                <ui:HyperlinkButton
                    Margin="-8,5,0,0"
                    HorizontalAlignment="Left"
                    Content="yujonny.com"
                    NavigateUri="https://yujonny.com" />
                <ui:HyperlinkButton
                    Margin="-8,0,0,0"
                    HorizontalAlignment="Left"
                    Content="yujonny@icloud.com"
                    NavigateUri="mailto:yujonny@icloud.com" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
