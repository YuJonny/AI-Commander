<Window
    x:Class="Commander.VoiceHud"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    SizeToContent="WidthAndHeight"
    ResizeMode="NoResize"
    WindowStyle="None"
    AllowsTransparency="True"
    ShowActivated="False"
    ShowInTaskbar="False"
    Topmost="True"
    Focusable="False"
    Background="Transparent">

    <!--
        自绘胶囊，刻意不用 Mica / Acrylic / WindowCornerPreference——那三样都是 Windows 11 专属，
        在 Win10 上会整个失效，退化成一个白色直角方框（用户实测到的就是这个）。
        AllowsTransparency + 自绘圆角在 Win10/11 上表现完全一致。
        尺寸与形状对齐 macOS 版的 Listening 胶囊：高 36、全圆角、深色半透明、宽度随文字自适应。
    -->
    <Border
        x:Name="Capsule"
        Height="36"
        MinWidth="128"
        Margin="16"
        Padding="14,0,16,0"
        CornerRadius="18"
        BorderThickness="1"
        IsHitTestVisible="False">
        <Border.Background>
            <SolidColorBrush Color="#1C1C1E" Opacity="0.92" />
        </Border.Background>
        <Border.BorderBrush>
            <SolidColorBrush Color="#FFFFFF" Opacity="0.14" />
        </Border.BorderBrush>
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="0.34" Color="#000000" />
        </Border.Effect>

        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Orientation="Horizontal">
            <!-- 呼吸光晕：让"正在听"有生命感，而不是一个死点 -->
            <Grid Width="10" Height="10" VerticalAlignment="Center">
                <Ellipse x:Name="StateHalo" Fill="#E53935" Opacity="0.35" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <ScaleTransform x:Name="HaloScale" ScaleX="1" ScaleY="1" />
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse
                    x:Name="StateDot"
                    Width="7"
                    Height="7"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Fill="#E53935" />
                <Grid.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimation
                                    Storyboard.TargetName="HaloScale"
                                    Storyboard.TargetProperty="ScaleX"
                                    From="1" To="2" Duration="0:0:1.2" />
                                <DoubleAnimation
                                    Storyboard.TargetName="HaloScale"
                                    Storyboard.TargetProperty="ScaleY"
                                    From="1" To="2" Duration="0:0:1.2" />
                                <DoubleAnimation
                                    Storyboard.TargetName="StateHalo"
                                    Storyboard.TargetProperty="Opacity"
                                    From="0.4" To="0" Duration="0:0:1.2" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Grid.Triggers>
            </Grid>

            <TextBlock
                x:Name="StateText"
                Margin="9,0,0,0"
                MaxWidth="240"
                VerticalAlignment="Center"
                FontSize="13.5"
                FontWeight="Medium"
                Foreground="#F2F2F7"
                Text="Listening"
                TextTrimming="CharacterEllipsis" />
        </StackPanel>
    </Border>
</Window>
