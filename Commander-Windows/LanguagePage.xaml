<UserControl
    x:Class="Commander.LanguagePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    FontFamily="Segoe UI Variable Text, Microsoft YaHei UI">

    <UserControl.Resources>
        <Style x:Key="LangButtonStyle" TargetType="ToggleButton">
            <Setter Property="Height" Value="48" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border
                            x:Name="Surface"
                            Padding="{TemplateBinding Padding}"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="6">
                            <Grid>
                                <ContentPresenter
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <ui:SymbolIcon
                                    x:Name="Check"
                                    HorizontalAlignment="Right"
                                    Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                    Symbol="CheckmarkCircle20"
                                    Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel Margin="4,24,4,0">
        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
            <TextBlock
                FontSize="22"
                FontWeight="SemiBold"
                Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                Text="中" />
            <Border
                Width="1"
                Height="18"
                Margin="9,0"
                VerticalAlignment="Center"
                Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
            <TextBlock
                VerticalAlignment="Center"
                FontSize="15"
                FontWeight="SemiBold"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="EN" />
        </StackPanel>
        <TextBlock
            x:Name="LblTitle"
            Margin="0,14,0,0"
            HorizontalAlignment="Center"
            FontSize="20"
            FontWeight="SemiBold"
            Text="选择语言" />
        <TextBlock
            x:Name="LblDesc"
            Margin="0,5,0,22"
            HorizontalAlignment="Center"
            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
            Text="切换应用界面语言" />

        <Border Style="{StaticResource SubtlePanel}">
            <StackPanel>
                <ToggleButton
                    x:Name="BtnZh"
                    Content="中文"
                    Style="{StaticResource LangButtonStyle}"
                    Click="BtnZh_Click" />
                <Border Style="{StaticResource Divider}" Margin="14,2" />
                <ToggleButton
                    x:Name="BtnEn"
                    Content="English"
                    Style="{StaticResource LangButtonStyle}"
                    Click="BtnEn_Click" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
